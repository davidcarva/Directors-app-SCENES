rules_version = '2';

// Cada usuário só lê/escreve as PRÓPRIAS imagens.
// Console do Firebase → Storage → aba "Rules" → cole isto → Publicar.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/imgs/{imageId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
