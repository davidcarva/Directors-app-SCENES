rules_version = '2';

// Cada usuário só lê/escreve os PRÓPRIOS dados.
// Cobre: users/{uid}/roteiros, users/{uid}/imgs (fotos em dataURL) e
// users/{uid}/meta/tecImgs (referências do acervo).
// Console do Firebase → Firestore Database → aba "Regras" → cole isto → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // fecha o resto por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
